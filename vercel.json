{
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build-frontend.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://checkpoint-production-81f4.up.railway.app/api/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://checkpoint-production-81f4.up.railway.app/healthz"
    },
    {
      "source": "/readyz",
      "destination": "https://checkpoint-production-81f4.up.railway.app/readyz"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
